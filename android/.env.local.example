# Copy the needed lines into <repo root>/.env.local (or android/.env.local). That file is git-ignored.
# Never commit real keys. The build reads these names:

# Kakao Developers REST API key (place search + route finding). Needs "카카오맵" switched ON for the app.
KAKAO_REST_KEY=

# Seoul Open Data (data.seoul.go.kr) key for the real-time subway arrival API.
SUBWAY_KEY=
